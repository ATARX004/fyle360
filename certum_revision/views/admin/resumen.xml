<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Proyectos: el listado completo ══════════════════════════════
         Controlador: admin_proyectos. Contexto: procesos, total, paginas,
         filtro_estado, filtro_q, estados, conteo. -->
    <template id="admin_proyectos" name="FYLE 360 · panel: proyectos">
        <t t-call="certum_revision.admin_layout">
            <t t-set="titulo_pagina">Proyectos</t>
            <t t-set="subtitulo_pagina">Todos los proyectos de revisión, de todos los proveedores</t>

            <form method="get" action="/my/certum/admin/proyectos" class="sr-adm-filtros" role="search">
                <label class="sr-adm-campo sr-adm-campo-ancho">
                    <span>Buscar</span>
                    <input type="search" name="q" t-att-value="filtro_q"
                           placeholder="Código, referencia, proveedor o cliente"/>
                </label>
                <label class="sr-adm-campo">
                    <span>Estado</span>
                    <select name="estado">
                        <option value="">Todos</option>
                        <t t-foreach="estados" t-as="e">
                            <option t-att-value="e[0]" t-att-selected="'selected' if e[0] == filtro_estado else None">
                                <t t-esc="e[1]"/> (<t t-esc="conteo.get(e[0], 0)"/>)
                            </option>
                        </t>
                        <option value="listos" t-att-selected="'selected' if filtro_estado == 'listos' else None">Listos para cerrar</option>
                    </select>
                </label>
                <div class="sr-adm-filtros-acciones">
                    <button type="submit" class="sr-btn sr-btn-primary">Filtrar</button>
                    <a t-if="filtro_q or filtro_estado" href="/my/certum/admin/proyectos" class="sr-btn sr-btn-ghost">Limpiar</a>
                </div>
            </form>

            <p class="sr-adm-recuento">
                <t t-esc="total"/> proyecto(s)<t t-if="filtro_q or filtro_estado"> con el filtro</t>
            </p>

            <div t-if="procesos" class="sr-grid">
                <div t-foreach="procesos" t-as="proceso" class="sr-adm-proy-card">
                    <t t-call="certum_revision.sr_proceso_card">
                        <t t-set="idx" t-value="proceso_index"/>
                    </t>
                    <div t-if="proceso.state in ('borrador', 'publicacion', 'revision')" class="sr-adm-proy-acciones">
                        <form t-if="proceso.state == 'borrador'" method="post"
                              t-attf-action="/my/certum/admin/proyecto/#{proceso.id}/abrir"
                              data-sr-confirmar="¿Abrir el proyecto? Se copia la plantilla y el proveedor podrá publicar.">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="sr-btn sr-btn-primary sr-btn-sm">Abrir proyecto</button>
                        </form>
                        <form t-else="" method="post"
                              t-attf-action="/my/certum/admin/proyecto/#{proceso.id}/fuera-plazo"
                              data-sr-confirmar="¿Marcar este proyecto fuera de plazo? Se detiene la publicación y la revisión.">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="sr-btn sr-btn-ghost sr-btn-sm">Marcar fuera de plazo</button>
                        </form>
                    </div>
                </div>
            </div>
            <t t-else="" t-call="certum_revision.admin_vacio">
                <t t-set="mensaje">
                    <t t-if="filtro_q or filtro_estado">Ningún proyecto coincide con el filtro.</t>
                    <t t-else="">Todavía no hay proyectos. Los inicia el proveedor desde sus plantillas, o Certum desde Plantillas.</t>
                </t>
            </t>

            <nav t-if="paginas" class="sr-adm-paginas" aria-label="Paginación">
                <t t-foreach="paginas" t-as="pg">
                    <a t-att-href="pg['url']" t-attf-class="sr-adm-pagina #{'is-on' if pg['activa'] else ''}"
                       t-att-aria-current="'page' if pg['activa'] else None" t-esc="pg['numero']"/>
                </t>
            </nav>
        </t>
    </template>

</odoo>
