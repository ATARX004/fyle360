<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══ Listado de procesos del proveedor ═══════════════════════════ -->
    <template id="portal_procesos" name="Certum Global Rev · Mis procesos (proveedor)">
        <t t-call="certum_revision.sr_layout">
            <header class="sr-page-head sr-anim-up">
                <h1>Mis procesos</h1>
                <p class="sr-muted">Publica los documentos de cada ítem antes de la fecha límite.</p>
            </header>
            <div class="sr-grid">
                <t t-foreach="procesos" t-as="proceso">
                    <t t-call="certum_revision.sr_proceso_card">
                        <t t-set="idx" t-value="proceso_index"/>
                    </t>
                </t>
            </div>
            <div t-if="not procesos" class="sr-empty sr-anim-up">
                <svg class="sr-ico sr-empty-ico"><use href="#i-folder"/></svg>
                <h3>No tienes procesos abiertos</h3>
                <p class="sr-muted">Cuando Certum Global abra tu proceso de revisión lo verás aquí.</p>
            </div>
        </t>
    </template>

    <!-- ══ Detalle de proceso (compartido proveedor/cliente) ═══════════
         Pestañas flotantes por carpeta + grid de ítems; el drawer del
         ítem se carga por AJAX (/my/item/<id>/panel).                  -->
    <template id="portal_proceso_detail" name="Certum Global Rev · Detalle de proceso">
        <t t-call="certum_revision.sr_layout">
            <header class="sr-proc-head sr-card sr-anim-up">
                <div class="sr-proc-head-info">
                    <span class="sr-proceso-name" t-esc="proceso.name"/>
                    <h1 t-esc="proceso.checklist_id.name"/>
                    <div class="sr-proc-parties">
                        <span class="sr-party">
                            <t t-call="certum_revision.sr_avatar"><t t-set="partner" t-value="proceso.proveedor_id"/></t>
                            <span class="sr-party-txt">
                                <small>Proveedor</small>
                                <b t-esc="proceso.proveedor_id.name"/>
                            </span>
                        </span>
                        <svg class="sr-ico sr-party-arrow"><use href="#i-arrow-r"/></svg>
                        <span class="sr-party">
                            <t t-call="certum_revision.sr_avatar"><t t-set="partner" t-value="proceso.cliente_id"/></t>
                            <span class="sr-party-txt">
                                <small>Cliente</small>
                                <b t-esc="proceso.cliente_id.name"/>
                            </span>
                        </span>
                    </div>
                    <div class="sr-proc-chips">
                        <t t-set="sr_state_labels"
                           t-value="{'borrador': 'Borrador', 'publicacion': 'Publicación', 'revision': 'Revisión', 'completado': 'Completado', 'fuera_plazo': 'Fuera de plazo'}"/>
                        <span class="sr-chip" t-att-data-state="proceso.state">
                            <t t-esc="sr_state_labels.get(proceso.state, proceso.state)"/>
                        </span>
                        <span t-if="proceso.semaforo and proceso.semaforo != 'na'"
                              class="sr-chip sr-chip-semaforo" t-att-data-semaforo="proceso.semaforo">
                            <svg class="sr-ico"><use href="#i-clock"/></svg>
                            <t t-esc="proceso.dias_para_cambio"/> días restantes
                        </span>
                        <span class="sr-chip sr-chip-plain" t-if="proceso.fecha_limite">
                            <svg class="sr-ico"><use href="#i-flag"/></svg>
                            Límite <t t-esc="proceso.fecha_limite.strftime('%d/%m/%Y')"/>
                        </span>
                    </div>
                </div>
                <div class="sr-proc-head-side">
                    <div class="sr-ring sr-ring-lg" t-att-data-avance="int(proceso.avance)">
                        <svg viewBox="0 0 72 72">
                            <circle class="sr-ring-bg" cx="36" cy="36" r="30"/>
                            <circle class="sr-ring-fg" cx="36" cy="36" r="30"/>
                        </svg>
                        <span class="sr-ring-label"><t t-esc="int(proceso.avance)"/>%</span>
                    </div>
                    <a t-if="proceso.state != 'borrador' and n_aprobados"
                       class="sr-btn sr-btn-primary sr-btn-zip"
                       t-att-href="'/my/proceso/%d/descargar' % proceso.id">
                        <svg class="sr-ico"><use href="#i-download"/></svg>
                        Descargar aprobados
                        <span class="sr-btn-count"><t t-esc="n_aprobados"/></span>
                    </a>
                    <span t-if="proceso.state != 'borrador' and not n_aprobados"
                          class="sr-muted sr-mini sr-zip-empty">
                        Aún no hay documentos aprobados que descargar.
                    </span>
                </div>
            </header>

            <!-- Aviso de resultado de una acción (descarga, archivo depurado…) -->
            <div t-if="aviso" class="sr-alert sr-alert-warn sr-anim-up">
                <svg class="sr-ico"><use href="#i-alert"/></svg>
                <span t-esc="aviso"/>
            </div>

            <!-- Advertencia permanente sobre la depuración de versiones -->
            <div t-if="proceso.state != 'borrador'" class="sr-alert sr-alert-info sr-anim-up">
                <svg class="sr-ico"><use href="#i-alert"/></svg>
                <span>
                    <b>Conserve una copia en su equipo.</b>
                    El paquete incluye solo los documentos aprobados y, de cada uno,
                    únicamente la versión vigente. Las versiones superadas se depuran
                    a los <t t-esc="dias_purga"/> días: se borra el archivo, aunque
                    queda registrado que existió, quién lo subió y cuándo.
                </span>
            </div>

            <!-- Gestión del proceso: política de revisión + solicitudes de plazo -->
            <section class="sr-proc-gestion sr-anim-up" id="srProcGestion"
                     t-att-data-proceso="proceso.id" t-att-data-nivel="nivel" t-att-data-rol="rol">
                <div class="sr-gest-card">
                    <div class="sr-gest-head">
                        <div class="sr-gest-ico"><svg class="sr-ico"><use href="#i-shield"/></svg></div>
                        <div class="sr-gest-txt">
                            <b>Política de revisión</b>
                            <p class="sr-muted sr-mini">
                                <t t-if="proceso.revision_modo == 'secuencial'">Por capas · <t t-esc="proceso.revision_capas"/> nivel(es) hasta el nivel 1</t>
                                <t t-elif="proceso.revision_modo == 'personas'"><t t-esc="len(participantes)"/> participante(s) designado(s), en orden</t>
                                <t t-else="">Cualquier contacto del cliente puede aprobar</t>
                            </p>
                        </div>
                    </div>
                    <div t-if="rol == 'cliente' and nivel == 1" class="sr-gest-form">
                        <select id="srPolModo">
                            <option value="cualquiera" t-att-selected="'selected' if proceso.revision_modo == 'cualquiera' else None">Cualquiera aprueba</option>
                            <option value="secuencial" t-att-selected="'selected' if proceso.revision_modo == 'secuencial' else None">Por niveles (capas)</option>
                            <option value="personas" t-att-selected="'selected' if proceso.revision_modo == 'personas' else None">Participantes designados</option>
                        </select>
                        <input type="number" id="srPolCapas" min="1" max="20" t-att-value="proceso.revision_capas" title="Capas"/>
                        <button type="button" class="sr-btn sr-btn-primary" data-act="guardar-politica">
                            <svg class="sr-ico"><use href="#i-check"/></svg>Guardar
                        </button>
                    </div>
                    <p t-elif="rol == 'cliente'" class="sr-muted sr-mini">La política la define el nivel 1 de tu empresa.</p>

                    <!-- Participantes del proceso: quiénes revisan y en qué orden -->
                    <div t-if="rol == 'cliente'" class="sr-part-box" id="srPartBox"
                         t-att-data-abierto="'1' if proceso.revision_modo == 'personas' else '0'">
                        <p class="sr-part-help sr-muted sr-mini">
                            Elige quiénes participan y en qué orden. No tienen por qué
                            estar todos los de la empresa. El <b>último</b> de la lista
                            es la máxima autoridad. Un requisito concreto puede llevar
                            su propia cadena desde el panel del documento.
                        </p>
                        <div class="sr-chain" id="srPartChain"></div>
                        <div t-if="nivel == 1" class="sr-chain-pool" id="srPartPool"></div>
                        <div t-if="nivel == 1" class="sr-part-actions">
                            <button type="button" class="sr-btn sr-btn-primary" data-act="guardar-participantes">
                                <svg class="sr-ico"><use href="#i-check"/></svg>Guardar participantes
                            </button>
                        </div>
                        <p class="sr-muted sr-mini sr-part-nota">
                            Los documentos <b>ya publicados</b> conservan la cadena con
                            la que empezaron; un cambio aquí rige para lo que se publique
                            a partir de ahora.
                        </p>
                    </div>

                    <!-- Datos para el editor (los lee el JS) -->
                    <script type="application/json" id="srPartData" t-out="part_data_json"/>
                </div>

                <div class="sr-gest-card">
                    <div class="sr-gest-head">
                        <div class="sr-gest-ico"><svg class="sr-ico"><use href="#i-clock"/></svg></div>
                        <div class="sr-gest-txt">
                            <b>Plazo del proceso</b>
                            <p class="sr-muted sr-mini">
                                Límite <t t-esc="proceso.fecha_limite.strftime('%d/%m/%Y') if proceso.fecha_limite else '—'"/> · <t t-esc="proceso.plazo_dias"/> días
                            </p>
                        </div>
                        <button t-if="rol == 'cliente'" type="button" class="sr-btn sr-btn-ghost" data-act="toggle-solicitar">
                            <svg class="sr-ico"><use href="#i-plus"/></svg>Solicitar plazo
                        </button>
                    </div>
                    <div class="sr-solicitar-box" id="srSolicitarBox">
                        <input type="number" id="srSolDias" min="1" max="365" placeholder="Días adicionales"/>
                        <textarea id="srSolMotivo" placeholder="Motivo (opcional)…"></textarea>
                        <button type="button" class="sr-btn sr-btn-primary" data-act="enviar-solicitud">
                            <svg class="sr-ico"><use href="#i-send"/></svg>Enviar solicitud
                        </button>
                    </div>
                    <div t-if="solicitudes" class="sr-sol-list">
                        <t t-foreach="solicitudes" t-as="sol">
                            <div class="sr-sol-row" t-att-data-sol="sol.id" t-att-data-autnivel="sol.autorizador_nivel">
                                <div class="sr-sol-info">
                                    <span><b><t t-esc="sol.dias_pedidos"/> días</b> · <t t-esc="sol.solicitante_id.name"/></span>
                                    <span class="sr-chip sr-sol-chip" t-att-data-estado="sol.estado">
                                        <t t-esc="dict(sol._fields['estado'].selection).get(sol.estado)"/>
                                    </span>
                                    <p class="sr-muted sr-mini" t-if="sol.motivo"><t t-esc="sol.motivo"/></p>
                                </div>
                                <div class="sr-sol-actions">
                                    <t t-if="rol == 'cliente' and sol.estado == 'pendiente_autorizacion' and nivel and nivel &lt;= sol.autorizador_nivel">
                                        <button type="button" class="sr-btn sr-btn-ok" data-act="autorizar" data-decision="autorizar"><svg class="sr-ico"><use href="#i-check"/></svg>Autorizar</button>
                                        <button type="button" class="sr-btn sr-btn-warn" data-act="autorizar" data-decision="rechazar"><svg class="sr-ico"><use href="#i-x"/></svg></button>
                                    </t>
                                    <t t-if="rol == 'proveedor' and sol.estado == 'pendiente_proveedor'">
                                        <button type="button" class="sr-btn sr-btn-ok" data-act="decidir" data-decision="aprobar"><svg class="sr-ico"><use href="#i-check"/></svg>Aprobar</button>
                                        <button type="button" class="sr-btn sr-btn-warn" data-act="decidir" data-decision="rechazar"><svg class="sr-ico"><use href="#i-x"/></svg></button>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <!-- Pestañas flotantes por carpeta -->
            <nav class="sr-tabs sr-anim-up" id="srTabs">
                <button type="button" class="sr-tab is-active" data-tab="all">
                    <svg class="sr-ico"><use href="#i-folder"/></svg> Todo
                    <span class="sr-tab-count" t-esc="proceso.total_items"/>
                </button>
                <t t-foreach="carpetas" t-as="carpeta">
                    <button type="button" class="sr-tab" t-att-data-tab="carpeta.id">
                        <svg class="sr-ico"><use href="#i-folder"/></svg>
                        <t t-esc="carpeta.name"/>
                        <span class="sr-tab-count">
                            <t t-esc="carpeta.items_aprobados"/>/<t t-esc="carpeta.total_items"/>
                        </span>
                    </button>
                </t>
            </nav>

            <!-- Grid de ítems -->
            <section class="sr-grid sr-items-grid" id="srItems">
                <t t-foreach="items_ordenados" t-as="item">
                    <article class="sr-card sr-item sr-anim-up"
                             t-att-data-item="item.id"
                             t-att-data-carpeta="item.carpeta_id.id or 'none'"
                             t-att-data-state="item.state"
                             t-att-style="'animation-delay:%sms' % (min(item_index, 10) * 40)"
                             tabindex="0" role="button">
                        <div class="sr-item-top">
                            <div class="sr-item-ico"><svg class="sr-ico"><use href="#i-doc"/></svg></div>
                            <span class="sr-chip sr-item-chip" t-att-data-state="item.state">
                                <t t-if="item.state == 'pendiente'">Pendiente</t>
                                <t t-elif="item.state == 'publicado'">Publicado</t>
                                <t t-elif="item.state == 'observado'">Observado</t>
                                <t t-else="">Aprobado</t>
                            </span>
                        </div>
                        <h4 t-esc="item.name"/>
                        <p class="sr-muted sr-mini">
                            <t t-esc="item.carpeta_id.name or 'General'"/>
                            <t t-if="item.required"> · Obligatorio</t>
                        </p>
                        <div class="sr-item-foot">
                            <span class="sr-mini sr-muted" t-if="item.comment_ids">
                                <svg class="sr-ico"><use href="#i-comment"/></svg>
                                <t t-esc="len(item.comment_ids)"/>
                            </span>
                            <span class="sr-mini sr-muted" t-if="item.attachment_ids">
                                <svg class="sr-ico"><use href="#i-paperclip"/></svg>
                                <t t-esc="len(item.attachment_ids)"/>
                            </span>
                            <svg class="sr-ico sr-card-go"><use href="#i-chevron-r"/></svg>
                        </div>
                    </article>
                </t>
            </section>
        </t>
    </template>
</odoo>
