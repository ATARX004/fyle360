<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_checklist_list" model="ir.ui.view">
        <field name="name">certum.rev.checklist.list</field>
        <field name="model">certum.rev.checklist</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="sector"/>
                <field name="item_count" string="Ítems"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_checklist_form" model="ir.ui.view">
        <field name="name">certum.rev.checklist.form</field>
        <field name="model">certum.rev.checklist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sector"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Descripción de la plantilla…"/>
                    <notebook>
                        <page string="Carpetas">
                            <field name="folder_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ítems">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="folder_id"/>
                                    <field name="required"/>
                                    <field name="doc_template_code" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_checklist" model="ir.actions.act_window">
        <field name="name">Checklists maestros</field>
        <field name="res_model">certum.rev.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer checklist maestro</p>
            <p>Define las carpetas e ítems estándar que se copiarán a cada proyecto de revisión.</p>
        </field>
    </record>
</odoo>
