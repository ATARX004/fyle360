<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══ Sprite de iconos SVG (sin emojis): <svg class="sr-ico"><use href="#i-x"/></svg> ══ -->
    <template id="sr_icons" name="FYLE 360 · Iconos SVG">
        <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
            <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-check-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8.5 12.2l2.4 2.4 4.6-4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
            <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3L2.5 20h19L12 3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 10v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="17" r="1.1" fill="currentColor"/></symbol>
            <symbol id="i-upload" viewBox="0 0 24 24"><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 15V4m0 0L7 9m5-5l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-download" viewBox="0 0 24 24"><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v11m0 0l-5-5m5 5l5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-comment" viewBox="0 0 24 24"><path d="M21 12a8 8 0 01-8 8H4l2.3-2.7A8 8 0 1121 12z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
            <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7a2 2 0 012-2h4l2 3h8a2 2 0 012 2v7a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
            <symbol id="i-doc" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6V3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M14 3v4h4M9 12h6M9 16h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
            <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
            <symbol id="i-send" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
            <symbol id="i-chevron-r" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-arrow-r" viewBox="0 0 24 24"><path d="M4 12h16m0 0l-6-6m6 6l-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-paperclip" viewBox="0 0 24 24"><path d="M21 11.5l-8.6 8.6a5 5 0 01-7-7l8.6-8.6a3.3 3.3 0 014.7 4.7L10 17.9a1.7 1.7 0 01-2.4-2.4l8-7.9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 2l8 3v6c0 5-3.4 9.4-8 11-4.6-1.6-8-6-8-11V5l8-3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
            <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-flag" viewBox="0 0 24 24"><path d="M5 21V4m0 1h13l-2.5 4L18 13H5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 8a8 8 0 10.7 6M20 3v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
            <symbol id="i-building" viewBox="0 0 24 24"><path d="M4 21V5a1 1 0 011-1h9a1 1 0 011 1v16M15 21V9h4a1 1 0 011 1v11M2 21h20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.5 8h3M7.5 12h3M7.5 16h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
            <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.4" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M5 20a7 7 0 0114 0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
            <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
            <symbol id="i-pencil" viewBox="0 0 24 24"><path d="M4 20h4L18.5 9.5a2 2 0 000-2.8l-1.2-1.2a2 2 0 00-2.8 0L4 16v4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M13.5 6.5l4 4" stroke="currentColor" stroke-width="1.8"/></symbol>
            <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4 7h16M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2M6 7l1 13a1 1 0 001 1h8a1 1 0 001-1l1-13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
            <symbol id="i-image" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="8.5" cy="9.5" r="1.6" fill="currentColor"/><path d="M4 17l4.5-4.5a2 2 0 012.8 0L20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></symbol>
            <symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 9a6 6 0 1112 0c0 6 2 7 2 7H4s2-1 2-7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 20a2 2 0 004 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
            <symbol id="i-sparkle" viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M19 15l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z" fill="currentColor"/></symbol>
        </svg>
    </template>

    <!-- ══ Avatar de empresa (foto de Contactos con fallback a iniciales) ══
         El partner debe venir de un recordset legible (empresa propia o
         recordset traído con sudo() por el controller). image_128 se embebe
         en base64 para no depender del ACL de /web/image. El avatar por
         defecto de Odoo es un SVG («PHN2…» / «PD94…» en base64): con el
         tipo PNG el navegador lo pintaba roto.                           -->
    <template id="sr_avatar" name="FYLE 360 · Avatar de empresa">
        <span t-attf-class="sr-avatar #{'sr-avatar--photo' if partner.image_128 else 'sr-avatar--ini'}"
              t-attf-style="--sr-av-h:#{(partner.id or 0) % 360}"
              t-att-title="partner.name">
            <img t-if="partner.image_128" class="sr-avatar-img" loading="lazy"
                 t-att-alt="partner.name"
                 t-att-src="'data:image/%s;base64,%s' % ('svg+xml' if partner.image_128.decode()[:4] in ('PHN2', 'PD94') else 'png', partner.image_128.decode())"/>
            <span t-else="" class="sr-avatar-ini"
                  t-esc="(partner.name or '?').strip()[:2].upper()"/>
        </span>
    </template>

    <!-- ══ Menú lateral: la única navegación de FYLE 360 ═══════════════
         Lo arma certum.rev.proceso.fyle_menu() según el rol GLOBAL del
         usuario. Administración es un grupo plegable (<details>): abierto
         solo cuando se está en una de sus pantallas. En el móvil el menú
         se abre con el botón de la barra superior (portal_base.js). -->
    <template id="sr_menu" name="FYLE 360 · Menú lateral">
        <t t-set="menu" t-value="request.env['certum.rev.proceso'].fyle_menu(request.httprequest.path)"/>
        <div class="sr-topbar">
            <button type="button" class="sr-topbar-btn" data-act="menu" aria-controls="srSide"
                    aria-expanded="false" aria-label="Abrir el menú">
                <svg class="sr-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
            </button>
            <a href="/my/certum" class="sr-side-brand" aria-label="FYLE 360, inicio">
                <img src="/certum_revision/static/src/img/fyle360_mark.svg" alt="" width="30" height="30"/>
                <span class="sr-nav-word">FYLE <span>360</span></span>
            </a>
        </div>
        <div class="sr-side-velo" data-act="menu-cerrar"></div>
        <aside class="sr-side" id="srSide" aria-label="Menú de FYLE 360">
            <a href="/my/certum" class="sr-side-brand sr-side-brand-lg" aria-label="FYLE 360, inicio">
                <img src="/certum_revision/static/src/img/fyle360_mark.svg" alt="" width="36" height="36"/>
                <span class="sr-nav-word">FYLE <span>360</span></span>
            </a>

            <nav class="sr-side-nav">
                <a t-foreach="menu['principal']" t-as="e" t-att-href="e['url']"
                   t-attf-class="sr-side-link #{'is-on' if e['activo'] else ''}"
                   t-att-aria-current="'page' if e['activo'] else None">
                    <svg class="sr-ico"><use t-att-href="'#%s' % e['icono']"/></svg>
                    <span class="sr-side-txt" t-esc="e['nombre']"/>
                    <span t-if="e['n']" class="sr-side-n" t-esc="e['n']"/>
                </a>

                <details t-if="menu['admin']" class="sr-side-grupo"
                         t-att-open="'open' if menu['admin_abierto'] else None">
                    <summary t-attf-class="sr-side-link #{'is-dentro' if menu['admin_abierto'] else ''}">
                        <svg class="sr-ico"><use href="#i-shield"/></svg>
                        <span class="sr-side-txt">Administración</span>
                        <svg class="sr-ico sr-side-flecha"><use href="#i-chevron-r"/></svg>
                    </summary>
                    <div class="sr-side-sub">
                        <a t-foreach="menu['admin']" t-as="e" t-att-href="e['url']"
                           t-attf-class="sr-side-link #{'is-on' if e['activo'] else ''}"
                           t-att-aria-current="'page' if e['activo'] else None">
                            <svg class="sr-ico"><use t-att-href="'#%s' % e['icono']"/></svg>
                            <span class="sr-side-txt" t-esc="e['nombre']"/>
                            <span t-if="e['n']" class="sr-side-n" t-esc="e['n']"/>
                        </a>
                    </div>
                </details>
            </nav>

            <div class="sr-side-quien">
                <t t-call="certum_revision.sr_avatar"><t t-set="partner" t-value="menu['empresa']"/></t>
                <div>
                    <strong t-esc="menu['empresa'].name"/>
                    <span t-esc="menu['rol_nombre']"/>
                </div>
            </div>
        </aside>
    </template>

    <!-- ══ Layout del portal de revisión ══════════════════════════════ -->
    <template id="sr_layout" name="FYLE 360 · Layout">
        <!-- Sin esto, la pestaña del navegador muestra el nombre técnico de
             la vista («FYLE 360 · Inicio | My Website»). -->
        <t t-if="not title" t-set="title" t-value="'FYLE 360 · Revisión documental'"/>
        <t t-call="website.layout">
            <div class="sr-app" t-att-data-rol="rol or ''">
                <t t-call="certum_revision.sr_icons"/>
                <input type="hidden" id="srCsrf" t-att-value="request.csrf_token()"/>

                <div class="sr-shell">
                    <t t-call="certum_revision.sr_menu"/>
                    <main class="sr-main" id="srMain"><t t-out="0"/></main>
                </div>

                <!-- Infraestructura UI: toasts + drawer -->
                <div class="sr-toasts" id="srToasts" aria-live="polite"></div>
                <div class="sr-backdrop" id="srBackdrop"></div>
                <aside class="sr-drawer" id="srDrawer" role="dialog" aria-modal="true">
                    <div class="sr-drawer-body" id="srDrawerBody">
                        <div class="sr-skeleton">
                            <div class="sr-sk-line w60"></div>
                            <div class="sr-sk-line w90"></div>
                            <div class="sr-sk-line w80"></div>
                            <div class="sr-sk-block"></div>
                        </div>
                    </div>
                </aside>
            </div>
        </t>
    </template>

    <!-- ══ Snippet: tarjeta de proceso (listados y hub) ═══════════════ -->
    <template id="sr_proceso_card" name="FYLE 360 · Card de proyecto">
        <t t-set="sr_state_labels"
           t-value="{'borrador': 'Borrador', 'publicacion': 'Publicación', 'revision': 'Revisión', 'completado': 'Completado', 'fuera_plazo': 'Fuera de plazo'}"/>
        <a t-attf-href="/my/proceso/#{proceso.id}" class="sr-card sr-proceso-card">
            <div class="sr-proceso-card-top">
                <div class="sr-proceso-card-head">
                    <t t-set="otra" t-value="proceso.proveedor_id if rol == 'cliente' else proceso.cliente_id"/>
                    <t t-call="certum_revision.sr_avatar"><t t-set="partner" t-value="otra"/></t>
                    <div>
                        <span class="sr-proceso-name" t-esc="proceso.name"/>
                        <h3 t-esc="proceso.checklist_id.name"/>
                        <p t-if="proceso.referencia" class="sr-proceso-ref"
                           t-esc="proceso.referencia"/>
                        <p class="sr-muted">
                            <t t-if="rol == 'proveedor'">Cliente: <t t-esc="proceso.cliente_id.name"/></t>
                            <t t-else="">Proveedor: <t t-esc="proceso.proveedor_id.name"/></t>
                        </p>
                        <!-- Certum supervisa a las dos partes: se nombra también al cliente. -->
                        <p t-if="rol == 'interno'" class="sr-muted">Cliente: <t t-esc="proceso.cliente_id.name"/></p>
                    </div>
                </div>
                <div class="sr-ring" t-att-data-avance="int(proceso.avance)">
                    <svg viewBox="0 0 72 72">
                        <circle class="sr-ring-bg" cx="36" cy="36" r="30"/>
                        <circle class="sr-ring-fg" cx="36" cy="36" r="30"/>
                    </svg>
                    <span class="sr-ring-label"><t t-esc="int(proceso.avance)"/>%</span>
                </div>
            </div>
            <div class="sr-proceso-card-bottom">
                <span class="sr-chip" t-att-data-state="proceso.state">
                    <t t-esc="sr_state_labels.get(proceso.state, proceso.state)"/>
                </span>
                <!-- Todo aprobado pero aun abierto. Sin esta marca habria que
                     entrar a cada proyecto para descubrir cual falta cerrar. -->
                <span t-if="proceso.listo_para_cerrar()" class="sr-chip sr-chip-cerrar">
                    <svg class="sr-ico"><use href="#i-check-circle"/></svg>Listo para cerrar
                </span>
                <span t-if="proceso.semaforo and proceso.semaforo != 'na'"
                      class="sr-chip sr-chip-semaforo" t-att-data-semaforo="proceso.semaforo">
                    <svg class="sr-ico"><use href="#i-clock"/></svg>
                    <t t-if="proceso.semaforo == 'critico'">Crítico</t>
                    <t t-elif="proceso.semaforo == 'urgente'">Urgente</t>
                    <t t-else="">A tiempo</t>,
                    <t t-esc="proceso.dias_para_cambio"/> días
                </span>
                <span class="sr-muted sr-mini" t-if="proceso.fecha_limite">
                    Límite: <t t-esc="proceso.fecha_limite.strftime('%d/%m/%Y')"/>
                </span>
            </div>
        </a>
    </template>
</odoo>
