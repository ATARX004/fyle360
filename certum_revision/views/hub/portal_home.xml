<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══ Inicio de FYLE 360: el resumen de cada rol ═════════════════
         Controlador: controllers/hub/home.py. Contexto: rol, empresa,
         cifras, pendientes (cliente/proveedor), atencion y proximos
         (interno), procesos.

         El anillo de cuatro azules del logo es el único elemento
         decorativo: se dibuja una vez al entrar y queda quieto. Todo lo
         demás va en paneles con su barra de título. -->
    <template id="portal_hub" name="FYLE 360 · Inicio">
        <t t-call="certum_revision.sr_layout">
            <header class="sr-hero">
                <svg class="sr-hero-ring" viewBox="0 0 130 130" aria-hidden="true">
                    <g transform="rotate(-90 65 65)" fill="none" stroke-width="11">
                        <circle cx="65" cy="65" r="48" pathLength="100" stroke="#8DB8E5" stroke-dasharray="21 79" stroke-dashoffset="0"/>
                        <circle cx="65" cy="65" r="48" pathLength="100" stroke="#3373B9" stroke-dasharray="21 79" stroke-dashoffset="-25"/>
                        <circle cx="65" cy="65" r="48" pathLength="100" stroke="#5C93CF" stroke-dasharray="21 79" stroke-dashoffset="-50"/>
                        <circle cx="65" cy="65" r="48" pathLength="100" stroke="#E1EBF6" stroke-dasharray="21 79" stroke-dashoffset="-75"/>
                    </g>
                </svg>
                <div class="sr-hero-avatar">
                    <t t-call="certum_revision.sr_avatar"><t t-set="partner" t-value="empresa"/></t>
                </div>
                <div class="sr-hero-info">
                    <p class="sr-hero-hello">Hola,</p>
                    <h1 t-esc="empresa.name"/>
                    <span t-if="rol" class="sr-chip sr-chip-rol">
                        <t t-if="rol == 'proveedor'">Proveedor: publica documentos</t>
                        <t t-elif="rol == 'cliente'">Cliente: revisa documentos</t>
                        <t t-else="">Certum Global: administra la plataforma</t>
                    </span>
                </div>
            </header>

            <div t-if="not rol" class="sr-empty">
                <svg class="sr-ico sr-empty-ico"><use href="#i-alert"/></svg>
                <h3>Su empresa aún no tiene un papel en FYLE 360</h3>
                <p class="sr-muted">Escriba a sistemas@certumglobal.pe para que Certum Global le asigne
                    el de proveedor o cliente. Mientras tanto, lo que le difundan aparece en Recibidos.</p>
            </div>

            <t t-if="cifras" t-call="certum_revision.admin_cifras"/>

            <!-- ── Interno: lo que pide atención en la plataforma ──── -->
            <t t-if="rol == 'interno'">
                <section class="sr-panel">
                    <div class="sr-panel-head">
                        <h2><svg class="sr-ico"><use href="#i-bell"/></svg>Requiere atención</h2>
                    </div>
                    <div class="sr-panel-body">
                        <ul t-if="atencion" class="sr-adm-atencion">
                            <li t-foreach="atencion" t-as="a" t-att-data-tono="a['tono']">
                                <svg class="sr-ico"><use t-att-href="'#%s' % a['icono']"/></svg>
                                <div class="sr-adm-atencion-txt">
                                    <strong t-esc="a['titulo']"/>
                                    <span class="sr-muted" t-esc="a['texto']"/>
                                </div>
                                <a t-att-href="a['url']" class="sr-btn sr-btn-ghost sr-btn-sm" t-esc="a['accion']"/>
                            </li>
                        </ul>
                        <p t-else="" class="sr-adm-ninguno">Nada pendiente: correos al día, ningún proyecto vencido y
                            todas las empresas con rol.</p>
                    </div>
                </section>

                <section class="sr-panel">
                    <div class="sr-panel-head">
                        <h2><svg class="sr-ico"><use href="#i-clock"/></svg>Próximos a vencer</h2>
                        <a href="/my/certum/admin/proyectos" class="sr-btn sr-btn-ghost sr-btn-sm">Ver todos los proyectos</a>
                    </div>
                    <div t-if="proximos" class="sr-panel-body">
                        <div class="sr-grid">
                            <t t-foreach="proximos" t-as="proceso">
                                <t t-call="certum_revision.sr_proceso_card">
                                    <t t-set="idx" t-value="proceso_index"/>
                                </t>
                            </t>
                        </div>
                    </div>
                    <div t-else="" class="sr-panel-body">
                        <p class="sr-adm-ninguno">No hay proyectos en curso. Se inician desde Plantillas.</p>
                    </div>
                </section>
            </t>

            <!-- ── Cliente y proveedor: lo que les toca hacer ──────── -->
            <section t-if="rol in ('cliente', 'proveedor')" class="sr-panel">
                <div class="sr-panel-head">
                    <h2>
                        <svg class="sr-ico"><use t-att-href="'#i-eye' if rol == 'cliente' else '#i-upload'"/></svg>
                        <t t-if="rol == 'cliente'">Por revisar</t>
                        <t t-else="">Por corregir y por publicar</t>
                    </h2>
                    <span class="sr-muted" t-if="pendientes">Lo más urgente primero</span>
                </div>
                <div t-if="pendientes" class="sr-panel-body is-flush">
                    <ul class="sr-tareas">
                        <li t-foreach="pendientes" t-as="p" t-att-data-mio="'1' if p['mio'] else None">
                            <a t-att-href="p['url']">
                                <span class="sr-tarea-doc">
                                    <strong t-esc="p['nombre']"/>
                                    <span class="sr-muted">
                                        <t t-esc="p['proyecto']"/><t t-if="p['carpeta']">, <t t-esc="p['carpeta']"/></t>
                                    </span>
                                </span>
                                <span class="sr-tarea-motivo" t-esc="p['motivo']"/>
                                <span t-if="p['plazo']['fecha']" class="sr-tarea-plazo" t-att-data-tono="p['plazo']['tono']">
                                    <t t-if="p['plazo']['dias'] &lt;= 0">Vence hoy</t>
                                    <t t-elif="p['plazo']['dias'] == 1">Vence mañana</t>
                                    <t t-else="">Quedan <t t-esc="p['plazo']['dias']"/> días</t>
                                    <small t-esc="p['plazo']['fecha']"/>
                                </span>
                                <span t-else="" class="sr-tarea-plazo">Sin plazo propio</span>
                                <svg class="sr-ico sr-tarea-ir"><use href="#i-chevron-r"/></svg>
                            </a>
                        </li>
                    </ul>
                </div>
                <div t-else="" class="sr-panel-body">
                    <p class="sr-adm-ninguno">
                        <t t-if="rol == 'cliente'">Nada por revisar: todo lo publicado ya tiene decisión.</t>
                        <t t-else="">Nada pendiente: no hay documentos observados ni por publicar.</t>
                    </p>
                </div>
            </section>

            <section t-if="rol in ('cliente', 'proveedor')" class="sr-panel">
                <div class="sr-panel-head">
                    <h2><svg class="sr-ico"><use href="#i-folder"/></svg>Sus proyectos</h2>
                    <a t-att-href="'/my/procesos' if rol == 'proveedor' else '/my/revisiones'"
                       class="sr-btn sr-btn-ghost sr-btn-sm">Ver todos</a>
                </div>
                <div class="sr-panel-body">
                    <div t-if="procesos" class="sr-grid">
                        <t t-foreach="procesos" t-as="proceso">
                            <t t-call="certum_revision.sr_proceso_card">
                                <t t-set="idx" t-value="proceso_index"/>
                            </t>
                        </t>
                    </div>
                    <p t-else="" class="sr-adm-ninguno">
                        <t t-if="rol == 'proveedor'">Arme una plantilla y pulse «Iniciar proyecto» para empezar.</t>
                        <t t-else="">Cuando un proveedor inicie un proyecto con su empresa, aparecerá aquí.</t>
                    </p>
                </div>
            </section>
        </t>
    </template>
</odoo>
