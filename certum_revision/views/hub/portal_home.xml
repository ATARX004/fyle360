<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_hub" name="Certum Global Rev · Hub">
        <t t-call="certum_revision.sr_layout">
            <header class="sr-hero sr-anim-up">
                <div>
                    <p class="sr-hero-hello">Hola,</p>
                    <h1 t-esc="empresa.name"/>
                    <span t-if="rol" class="sr-chip sr-chip-rol">
                        <svg class="sr-ico"><use href="#i-shield"/></svg>
                        <t t-if="rol == 'proveedor'">Proveedor</t>
                        <t t-elif="rol == 'cliente'">Cliente</t>
                        <t t-else="">Interno</t>
                    </span>
                </div>
            </header>

            <t t-if="not rol">
                <div class="sr-empty sr-anim-up">
                    <svg class="sr-ico sr-empty-ico"><use href="#i-alert"/></svg>
                    <h3>Tu cuenta aún no tiene un rol asignado</h3>
                    <p class="sr-muted">Contacta al equipo Certum Global para habilitar tu acceso al flujo de revisión.</p>
                </div>
            </t>

            <!-- Panel de administración: el interno gestiona desde el backend -->
            <t t-if="rol == 'interno'">
                <section class="sr-admin">
                    <a href="/odoo/action-certum_revision.action_proceso"
                       class="sr-card sr-admin-card sr-anim-up">
                        <div class="sr-admin-ico"><svg class="sr-ico"><use href="#i-folder"/></svg></div>
                        <div class="sr-admin-txt">
                            <h3>Procesos de revisión</h3>
                            <p class="sr-muted">Crear procesos, abrirlos y supervisar el avance.</p>
                        </div>
                        <svg class="sr-ico sr-card-go"><use href="#i-arrow-r"/></svg>
                    </a>
                    <a href="/odoo/action-certum_revision.action_checklist"
                       class="sr-card sr-admin-card sr-anim-up" style="animation-delay:80ms">
                        <div class="sr-admin-ico"><svg class="sr-ico"><use href="#i-doc"/></svg></div>
                        <div class="sr-admin-txt">
                            <h3>Checklists maestros</h3>
                            <p class="sr-muted">Definir las carpetas e ítems estándar reutilizables.</p>
                        </div>
                        <svg class="sr-ico sr-card-go"><use href="#i-arrow-r"/></svg>
                    </a>
                </section>
            </t>

            <t t-if="kpis">
                <section class="sr-kpis">
                    <t t-foreach="kpis" t-as="kpi">
                        <div class="sr-card sr-kpi sr-anim-up" t-att-data-tone="kpi['tone']"
                             t-att-style="'animation-delay:%sms' % (kpi_index * 70)">
                            <div class="sr-kpi-ico"><svg class="sr-ico"><use t-att-href="'#%s' % kpi['icon']"/></svg></div>
                            <div>
                                <span class="sr-kpi-value" t-att-data-count="kpi['value']">0</span>
                                <p class="sr-muted" t-esc="kpi['label']"/>
                            </div>
                        </div>
                    </t>
                </section>

                <section class="sr-section">
                    <div class="sr-section-head">
                        <h2><t t-if="rol == 'interno'">Todos los procesos</t><t t-else="">Tus procesos</t></h2>
                        <a t-if="rol != 'interno'"
                           t-att-href="'/my/procesos' if rol == 'proveedor' else '/my/revisiones'"
                           class="sr-btn sr-btn-ghost">
                            Ver todos <svg class="sr-ico"><use href="#i-chevron-r"/></svg>
                        </a>
                        <a t-else="" href="/odoo/action-certum_revision.action_proceso"
                           class="sr-btn sr-btn-ghost">
                            Gestionar <svg class="sr-ico"><use href="#i-chevron-r"/></svg>
                        </a>
                    </div>
                    <div class="sr-grid">
                        <t t-foreach="procesos" t-as="proceso">
                            <t t-call="certum_revision.sr_proceso_card">
                                <t t-set="idx" t-value="proceso_index"/>
                            </t>
                        </t>
                    </div>
                    <div t-if="not procesos" class="sr-empty">
                        <svg class="sr-ico sr-empty-ico"><use href="#i-folder"/></svg>
                        <h3>Sin procesos por ahora</h3>
                        <p t-if="rol == 'interno'" class="sr-muted">
                            Crea el primero desde el backend: <b>Certum Global · Revisión → Procesos</b>.
                        </p>
                        <p t-else="" class="sr-muted">Cuando se abra un proceso de revisión aparecerá aquí.</p>
                    </div>
                </section>
            </t>
        </t>
    </template>
</odoo>
