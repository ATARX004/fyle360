<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══ Inicio de FYLE 360 ═════════════════════════════════════════
         Controlador: controllers/hub/home.py. Contexto: rol, empresa,
         kpis, procesos.

         El anillo de cuatro azules del logo es el único elemento
         decorativo de la portada: se dibuja una vez al entrar y queda
         quieto. Todo lo demás es contenido. -->
    <template id="portal_hub" name="FYLE 360 · Inicio">
        <t t-call="certum_revision.sr_layout">
            <header class="sr-hero">
                <svg class="sr-hero-ring" viewBox="0 0 130 130" aria-hidden="true">
                    <g transform="rotate(-90 65 65)" fill="none" stroke-width="11">
                        <circle cx="65" cy="65" r="48" pathLength="100" stroke="#8DB8E5" stroke-dasharray="21 79" stroke-dashoffset="0"/>
                        <circle cx="65" cy="65" r="48" pathLength="100" stroke="#3373B9" stroke-dasharray="21 79" stroke-dashoffset="-25"/>
                        <circle cx="65" cy="65" r="48" pathLength="100" stroke="#5C93CF" stroke-dasharray="21 79" stroke-dashoffset="-50"/>
                        <circle cx="65" cy="65" r="48" pathLength="100" stroke="#E1EBF6" stroke-dasharray="21 79" stroke-dashoffset="-75"/>
                    </g>
                </svg>
                <div class="sr-hero-avatar">
                    <t t-call="certum_revision.sr_avatar"><t t-set="partner" t-value="empresa"/></t>
                </div>
                <div class="sr-hero-info">
                    <p class="sr-hero-hello">Hola,</p>
                    <h1 t-esc="empresa.name"/>
                    <span t-if="rol" class="sr-chip sr-chip-rol">
                        <t t-if="rol == 'proveedor'">Proveedor: publica documentos</t>
                        <t t-elif="rol == 'cliente'">Cliente: revisa documentos</t>
                        <t t-else="">Certum Global: administra la plataforma</t>
                    </span>
                </div>
            </header>

            <t t-if="not rol">
                <div class="sr-empty">
                    <svg class="sr-ico sr-empty-ico"><use href="#i-alert"/></svg>
                    <h3>Su empresa aún no tiene un papel en FYLE 360</h3>
                    <p class="sr-muted">Escriba a sistemas@certumglobal.pe para que Certum Global le asigne
                        el de proveedor o cliente. Mientras tanto, lo que le difundan aparece en Recibidos.</p>
                </div>
            </t>

            <!-- Atajos según el papel -->
            <section t-if="rol == 'interno'" class="sr-admin">
                <a href="/my/certum/admin" class="sr-card sr-admin-card">
                    <div class="sr-admin-ico"><svg class="sr-ico"><use href="#i-shield"/></svg></div>
                    <div class="sr-admin-txt">
                        <h3>Administración</h3>
                        <p class="sr-muted">Proyectos, empresas, correos y ajustes de la plataforma.</p>
                    </div>
                </a>
                <a href="/my/plantillas" class="sr-card sr-admin-card">
                    <div class="sr-admin-ico"><svg class="sr-ico"><use href="#i-doc"/></svg></div>
                    <div class="sr-admin-txt">
                        <h3>Plantillas</h3>
                        <p class="sr-muted">Arme carpetas y requisitos e inicie proyectos.</p>
                    </div>
                </a>
            </section>
            <section t-if="rol == 'proveedor'" class="sr-admin">
                <a href="/my/plantillas" class="sr-card sr-admin-card">
                    <div class="sr-admin-ico"><svg class="sr-ico"><use href="#i-doc"/></svg></div>
                    <div class="sr-admin-txt">
                        <h3>Mis plantillas</h3>
                        <p class="sr-muted">Arme sus carpetas y requisitos e inicie un proyecto.</p>
                    </div>
                </a>
            </section>

            <t t-if="kpis">
                <dl class="sr-kpis">
                    <t t-foreach="kpis" t-as="kpi">
                        <div class="sr-kpi" t-att-data-tone="kpi['tone']">
                            <dt class="sr-muted" t-esc="kpi['label']"/>
                            <dd class="sr-kpi-value" t-esc="kpi['value']"/>
                        </div>
                    </t>
                </dl>

                <section class="sr-section">
                    <div class="sr-section-head">
                        <h2><t t-if="rol == 'interno'">Todos los proyectos</t><t t-else="">Sus proyectos</t></h2>
                        <a t-att-href="'/my/procesos' if rol == 'proveedor' else '/my/revisiones' if rol == 'cliente' else '/my/certum/admin/proyectos'"
                           class="sr-btn sr-btn-ghost">Ver todos</a>
                    </div>
                    <div class="sr-grid">
                        <t t-foreach="procesos" t-as="proceso">
                            <t t-call="certum_revision.sr_proceso_card">
                                <t t-set="idx" t-value="proceso_index"/>
                            </t>
                        </t>
                    </div>
                    <div t-if="not procesos" class="sr-empty">
                        <svg class="sr-ico sr-empty-ico"><use href="#i-folder"/></svg>
                        <h3>Sin proyectos por ahora</h3>
                        <p t-if="rol == 'proveedor'" class="sr-muted">Arme una plantilla y pulse «Iniciar proyecto» para empezar.</p>
                        <p t-elif="rol == 'interno'" class="sr-muted">Los proyectos se inician desde Plantillas.</p>
                        <p t-else="" class="sr-muted">Cuando un proveedor inicie un proyecto con su empresa, aparecerá aquí.</p>
                    </div>
                </section>
            </t>
        </t>
    </template>
</odoo>
